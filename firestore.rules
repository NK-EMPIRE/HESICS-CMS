rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdminOrFounder() {
      return isAuthenticated() && (
        getUserData().hierarchy == 'founder' || 
        getUserData().hierarchy == 'admin'
      );
    }

    function isRootMaster() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'hesics1@gmail.com' ||
        getUserData().email.lower() == 'hesics1@gmail.com'
      );
    }

    // Organizations
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrFounder();
    }

    // Users Collection - Permanent protection for hesics1@gmail.com
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrFounder();
      // hesics1@gmail.com cannot be modified to inactive or non-founder, and CANNOT BE DELETED
      allow update: if isAdminOrFounder() && (
        resource.data.email.lower() != 'hesics1@gmail.com' ||
        (request.resource.data.is_active == true && request.resource.data.hierarchy == 'founder')
      );
      // HARD DELETE LOCK: Root master account cannot be deleted by anyone in the database
      allow delete: if isAdminOrFounder() && 
        resource.data.email.lower() != 'hesics1@gmail.com' &&
        resource.id != 'usr-root-hesics';
    }

    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrFounder();
    }

    // Clients, Deals & Activities
    match /clients/{clientId} {
      allow read, write: if isAuthenticated();
    }

    match /deals/{dealId} {
      allow read, write: if isAuthenticated();
    }

    match /activities/{activityId} {
      allow read, write: if isAuthenticated();
    }

    // Quotations & Invoices
    match /quotations/{quotationId} {
      allow read, write: if isAuthenticated();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isAuthenticated();
    }

    // Finance (Income & Expenses)
    match /income_entries/{entryId} {
      allow read, write: if isAuthenticated();
    }

    match /expense_entries/{entryId} {
      allow read, write: if isAuthenticated();
    }

    // Audit logs (Immutable)
    match /audit_logs/{logId} {
      allow read: if isAdminOrFounder();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}