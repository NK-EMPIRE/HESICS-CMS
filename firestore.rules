rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Root identity is derived from the verified Firebase Auth token, never from a
    // browser-local user object. Other users must have a membership document whose
    // document ID equals their Firebase Auth UID.
    function isRootMaster() {
      return isAuthenticated() && request.auth.token.email != null &&
        request.auth.token.email.lower() == 'hesics1@gmail.com';
    }

    function hasUserRecord() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserHierarchy() {
      return getUserData().hierarchy;
    }

    function isEmployeeOrAbove() {
      return isRootMaster() || (hasUserRecord() && (
        getUserHierarchy() == 'founder' ||
        getUserHierarchy() == 'superadmin' ||
        getUserHierarchy() == 'admin' ||
        getUserHierarchy() == 'officer' ||
        getUserHierarchy() == 'employee'
      ));
    }

    function isOfficerOrAbove() {
      return isRootMaster() || (hasUserRecord() && (
        getUserHierarchy() == 'founder' ||
        getUserHierarchy() == 'superadmin' ||
        getUserHierarchy() == 'admin' ||
        getUserHierarchy() == 'officer'
      ));
    }

    function isAdminOrAbove() {
      return isRootMaster() || (hasUserRecord() && (
        getUserHierarchy() == 'founder' ||
        getUserHierarchy() == 'superadmin' ||
        getUserHierarchy() == 'admin'
      ));
    }

    function isSuperAdminOrAbove() {
      return isRootMaster() || (hasUserRecord() && (
        getUserHierarchy() == 'founder' ||
        getUserHierarchy() == 'superadmin'
      ));
    }

    function sameOrg(resourceData) {
      return isRootMaster() || (
        hasUserRecord() && resourceData.org_id == getUserData().org_id
      );
    }

    match /organizations/{orgId} {
      allow read: if isAuthenticated() && (isRootMaster() || (hasUserRecord() && orgId == getUserData().org_id));
      allow write: if isAdminOrAbove() && (isRootMaster() || orgId == getUserData().org_id);
    }

    // Backward-compatible path used by the current client data adapter.
    match /organization/{orgId} {
      allow read: if isAuthenticated() && (isRootMaster() || (hasUserRecord() && orgId == getUserData().org_id));
      allow write: if isAdminOrAbove() && (isRootMaster() || orgId == getUserData().org_id);
    }

    match /users/{userId} {
      allow read: if isRootMaster() || (isAuthenticated() && userId == request.auth.uid) ||
        (isAuthenticated() && hasUserRecord() && resource.data.org_id == getUserData().org_id && resource.data.hierarchy != 'founder');
      allow create: if isAdminOrAbove() && (isRootMaster() || request.resource.data.org_id == getUserData().org_id);
      allow update: if isAdminOrAbove() && (isRootMaster() || (
        resource.data.org_id == getUserData().org_id &&
        resource.data.email.lower() != 'hesics1@gmail.com' &&
        resource.data.hierarchy != 'founder'
      ));
      allow delete: if isAdminOrAbove() && (isRootMaster() || (
        resource.data.org_id == getUserData().org_id &&
        resource.data.email.lower() != 'hesics1@gmail.com' &&
        resource.data.hierarchy != 'founder'
      ));
    }

    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrAbove();
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated() && sameOrg(resource.data);
      allow create, update: if isEmployeeOrAbove() && sameOrg(request.resource.data);
      allow delete: if isAdminOrAbove() && sameOrg(resource.data);
    }

    match /deals/{dealId} {
      allow read: if isAuthenticated() && sameOrg(resource.data);
      allow create, update: if isEmployeeOrAbove() && sameOrg(request.resource.data);
      allow delete: if isAdminOrAbove() && sameOrg(resource.data);
    }

    match /activities/{activityId} {
      allow read: if isAuthenticated() && sameOrg(resource.data);
      allow create, update: if isEmployeeOrAbove() && sameOrg(request.resource.data);
      allow delete: if isAdminOrAbove() && sameOrg(resource.data);
    }

    match /quotations/{quotationId} {
      allow read: if isEmployeeOrAbove() && sameOrg(resource.data);
      allow create, update: if isOfficerOrAbove() && sameOrg(request.resource.data);
      allow delete: if isOfficerOrAbove() && sameOrg(resource.data);
    }

    match /invoices/{invoiceId} {
      allow read: if isEmployeeOrAbove() && sameOrg(resource.data);
      allow create, update: if isOfficerOrAbove() && sameOrg(request.resource.data);
      allow delete: if isOfficerOrAbove() && sameOrg(resource.data);
    }

    // Public signing updates are intentionally disabled until a server-side
    // single-use signing-token endpoint is deployed.
    match /agreements/{agreementId} {
      allow read: if isAuthenticated() && sameOrg(resource.data);
      allow create: if isOfficerOrAbove() && sameOrg(request.resource.data);
      allow update: if isOfficerOrAbove() && sameOrg(request.resource.data);
      allow delete: if isOfficerOrAbove() && sameOrg(resource.data);
    }

    match /income_entries/{entryId} {
      allow read, create, update: if isOfficerOrAbove() && sameOrg(request.resource.data);
      allow delete: if isOfficerOrAbove() && sameOrg(resource.data);
    }

    match /expense_entries/{entryId} {
      allow read, create, update: if isOfficerOrAbove() && sameOrg(request.resource.data);
      allow delete: if isOfficerOrAbove() && sameOrg(resource.data);
    }

    match /meetings/{meetingId} {
      allow read: if isAuthenticated() && sameOrg(resource.data);
      allow create, update: if isEmployeeOrAbove() && sameOrg(request.resource.data);
      allow delete: if isEmployeeOrAbove() && sameOrg(resource.data);
    }

    match /notion_workspaces/{workspaceId} {
      allow read: if isEmployeeOrAbove() && sameOrg(resource.data);
      allow create, update: if isEmployeeOrAbove() && sameOrg(request.resource.data);
      allow delete: if isEmployeeOrAbove() && sameOrg(resource.data);
    }

    match /private_vault/{vaultId} {
      allow read: if isSuperAdminOrAbove() && sameOrg(resource.data);
      allow create, update: if isSuperAdminOrAbove() && sameOrg(request.resource.data);
      allow delete: if isSuperAdminOrAbove() && sameOrg(resource.data);
    }

    match /audit_logs/{logId} {
      allow read: if isAdminOrAbove();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
