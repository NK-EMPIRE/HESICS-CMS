rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isRootMaster() {
      return isAuthenticated() && request.auth.token.email != null &&
        request.auth.token.email.lower() == 'hesics1@gmail.com';
    }

    function hasUserRecord() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function sameOrg(orgId) {
      return isRootMaster() || (hasUserRecord() &&
        orgId == firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.org_id);
    }

    function validWrite() {
      return isAuthenticated() && request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/.*|text/plain|application/msword|application/vnd.openxmlformats-officedocument.*');
    }

    match /orgs/{orgId}/{category}/{fileName} {
      allow read: if isAuthenticated() && sameOrg(orgId);
      allow write: if validWrite() && sameOrg(orgId);
      allow delete: if isAuthenticated() && sameOrg(orgId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
